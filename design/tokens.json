{
  "$schema-note": "Źródło prawdy dla wyglądu Planera ogrodu. Wartości wyciągnięte z prototypu (docs/reference/prototype.dc.html). Jednostki: px, chyba że zaznaczono m (metry planu).",
  "version": 1,

  "color": {
    "bg":               { "value": "#EEF1EC", "use": "tło aplikacji" },
    "surface":          { "value": "#FFFFFF", "use": "panele, nagłówek, przyciski" },
    "surfaceMuted":     { "value": "#F2F5F1", "use": "kafelki statystyk, hover FileButton" },
    "stageWell":        { "value": "#E4E8E3", "use": "tło przewijanego obszaru wokół planu" },
    "stage":            { "value": "#FFFFFF", "use": "tło samego planu (pod siatką)" },
    "stageRing":        { "value": "#B8C0B9", "use": "obrys planu (box-shadow 1px)" },

    "text":             { "value": "#1E2A23", "use": "tekst główny, ikony" },
    "textSecondary":    { "value": "#3D4842", "use": "opisy, podpowiedzi, wartości pomocnicze" },
    "textMuted":        { "value": "#56615B", "use": "etykiety pól, nagłówki sekcji, linijki" },

    "border":           { "value": "#D9DED9", "use": "panele, przyciski nieaktywne w grupach, separatory" },
    "borderStrong":     { "value": "#C9D0CA", "use": "przyciski drugorzędne, pola" },
    "divider":          { "value": "#E6EAE5", "use": "wiersze podsumowania, elementy listy" },
    "dividerSoft":      { "value": "#EEF1EC", "use": "wiersze długości boków" },

    "accent":           { "value": "#2F6B3F", "use": "marka, akcja główna, focus, aktywny przełącznik" },
    "accentHover":      { "value": "#1E4A2A", "use": "hover linku" },
    "accentSelected":   { "value": "#E3EFE5", "use": "tło wybranego narzędzia / segmentu / chipa" },
    "onAccent":         { "value": "#FFFFFF" },

    "selection":        { "value": "#C2561A", "use": "rola: zaznaczony element (obrys, uchwyty, wymiary, nagłówek inspektora)" },
    "selectionSoft":    { "value": "#FBEDE4", "use": "tło zaznaczonego elementu listy" },
    "selectionFill":    { "value": "rgba(194,86,26,0.08)" },

    "draft":            { "value": "#1F5FBF", "use": "rola: szkic rysowania (linia, punkty, wymiary, info)" },
    "draftFill":        { "value": "rgba(31,95,191,0.08)" },
    "draftRectFill":    { "value": "rgba(31,95,191,0.10)" },

    "calib":            { "value": "#6A3A9C", "use": "rola: kalibracja mapki" },
    "calibSoft":        { "value": "#F3EEF8", "use": "tło bloku kalibracji" },
    "calibText":        { "value": "#3D2A52" },
    "calibLabel":       { "value": "#4A3A5C" },
    "calibBorder":      { "value": "#C9BFD6" },

    "danger":           { "value": "#8A3B24", "use": "Usuń, × w wierzchołkach; też kolor granicy działki" },

    "notice":           { "value": "#E9F3EB", "use": "tło paska komunikatu" },
    "noticeBorder":     { "value": "#B9D3BF" },

    "labelBg":          { "value": "rgba(255,255,255,0.88)", "use": "tło etykiet na planie" },

    "grid": {
      "major":          { "value": "rgba(30,42,35,0.20)", "use": "co 5 m (PNG: 0.18)" },
      "minor":          { "value": "rgba(30,42,35,0.07)", "use": "co 1 m" }
    }
  },

  "material": {
    "boundary": { "fill": "none", "stroke": "#8A3B24", "strokeWidth": 2, "dash": "8 5", "toolDash": "3 2", "dimLabelBg": "#8A3B24" },
    "grass":    { "fill": "pattern:grass",  "stroke": "#5E8F45", "strokeWidth": 1, "solid": "#A8CF85",
                  "pattern": { "size": [0.5, 0.5], "base": "#A8CF85", "ink": "#78A858", "kind": "blades",
                               "svg": "<rect width='0.5' height='0.5' fill='#A8CF85'/><path d='M0.08 0.32 l0.04 -0.12 M0.3 0.46 l0.04 -0.12 M0.36 0.18 l0.03 -0.11' stroke='#78A858' stroke-width='0.025' fill='none'/>" } },
    "paving":   { "fill": "pattern:paving", "stroke": "#6F695F", "strokeWidth": 1, "solid": "#C7C1B6",
                  "pattern": { "size": [0.4, 0.2], "base": "#C7C1B6", "ink": "#9A9387", "kind": "running-bond",
                               "svg": "<rect width='0.4' height='0.2' fill='#C7C1B6'/><path d='M0 0 H0.4 M0 0.1 H0.4 M0.2 0 V0.1 M0.01 0.1 V0.2 M0.39 0.1 V0.2' stroke='#9A9387' stroke-width='0.012' fill='none'/>" } },
    "gravel":   { "fill": "pattern:gravel", "stroke": "#9C927C", "strokeWidth": 1, "solid": "#E3DDCF",
                  "pattern": { "size": [0.3, 0.3], "base": "#E3DDCF", "kind": "dots",
                               "svg": "<rect width='0.3' height='0.3' fill='#E3DDCF'/><circle cx='0.06' cy='0.08' r='0.025' fill='#B5AA93'/><circle cx='0.2' cy='0.05' r='0.018' fill='#A69B83'/><circle cx='0.15' cy='0.2' r='0.028' fill='#BDB39D'/><circle cx='0.26' cy='0.25' r='0.02' fill='#A69B83'/>" } },
    "bed":      { "fill": "pattern:bed",    "stroke": "#5E4430", "strokeWidth": 1, "solid": "#8F6E50",
                  "pattern": { "size": [0.4, 0.4], "base": "#8F6E50", "kind": "flowers",
                               "svg": "<rect width='0.4' height='0.4' fill='#8F6E50'/><circle cx='0.1' cy='0.12' r='0.05' fill='#C45C8A'/><circle cx='0.3' cy='0.3' r='0.05' fill='#E2B33C'/><circle cx='0.3' cy='0.08' r='0.03' fill='#6E513A'/><circle cx='0.08' cy='0.32' r='0.03' fill='#6E513A'/>" } },
    "house":    { "fill": "pattern:house",  "stroke": "#26302A", "strokeWidth": 2, "solid": "#ECE8E1",
                  "pattern": { "size": [0.5, 0.5], "base": "#ECE8E1", "ink": "#CDC5B8", "kind": "hatch-45", "transform": "rotate(45)",
                               "svg": "<rect width='0.5' height='0.5' fill='#ECE8E1'/><path d='M0 0 V0.5' stroke='#CDC5B8' stroke-width='0.06'/>" } },
    "shrub":    { "fill": "rgba(122,166,82,0.8)",  "stroke": "#4F7A35", "strokeWidth": 1.5, "centerDot": false },
    "conifer":  { "fill": "rgba(46,94,62,0.72)",   "stroke": "#1F4430", "strokeWidth": 1.5, "centerDot": true },
    "tree":     { "fill": "rgba(86,145,78,0.42)",  "stroke": "#3B6E38", "strokeWidth": 1.5, "centerDot": true },
    "centerDotRadius": { "value": "min(0.15 m, 0.2·r)" }
  },

  "font": {
    "sans": { "family": "'IBM Plex Sans', system-ui, sans-serif", "weights": [400, 500, 600], "use": "cały interfejs" },
    "mono": { "family": "'IBM Plex Mono', ui-monospace, monospace", "weights": [400, 500], "use": "wszystkie liczby: pola, wymiary, powierzchnie, współrzędne, zoom" },
    "googleFontsHref": "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
  },

  "type": {
    "appTitle":      { "size": 20, "weight": 600, "letterSpacing": "-0.01em" },
    "appSubtitle":   { "size": 13, "weight": 400, "color": "textMuted" },
    "sectionTitle":  { "size": 12, "weight": 600, "letterSpacing": "0.06em", "transform": "uppercase", "color": "textMuted" },
    "groupTitle":    { "size": 12, "weight": 500, "color": "textMuted" },
    "body":          { "size": 14, "weight": 400 },
    "bodySmall":     { "size": 13, "weight": 400, "lineHeight": 1.45, "color": "textSecondary" },
    "fieldLabel":    { "size": 12, "weight": 400, "color": "textMuted" },
    "hint":          { "size": 11, "weight": 400, "lineHeight": 1.4, "color": "textMuted" },
    "statValue":     { "size": 18, "weight": 500, "family": "mono" },
    "statValueSm":   { "size": 17, "weight": 500, "family": "mono" },
    "mono":          { "size": 12, "weight": 400, "family": "mono" },
    "monoSmall":     { "size": 11, "weight": 400, "family": "mono" },
    "stageLabel":    { "size": 12, "weight": 600 },
    "stageLabelSub": { "size": 11, "weight": 400, "family": "mono", "color": "textSecondary" }
  },

  "space": { "2": 2, "4": 4, "6": 6, "8": 8, "10": 10, "12": 12, "14": 14, "16": 16, "20": 20 },

  "radius": { "xs": 3, "sm": 4, "md": 6, "lg": 8, "xl": 10, "pill": 18 },

  "size": {
    "touchPrimary": 44,
    "touchPanel": 40,
    "touchCompact": 36,
    "vertexRow": 34,
    "field": 38,
    "fieldCompact": 36,
    "iconTool": 22,
    "iconButton": 18,
    "logo": 30,
    "checkbox": 18,
    "focusRing": { "width": 2, "offset": 1, "color": "accent" }
  },

  "layout": {
    "pagePadding": 16,
    "columnGap": 16,
    "panelGap": 12,
    "panelPadding": 14,
    "leftColumn":  { "flex": "1 1 240px" },
    "stageColumn": { "flex": "999 1 560px", "viewportHeight": 640, "stagePadding": "34px 32px 32px 46px" },
    "rightColumn": { "flex": "1 1 280px" },
    "header": { "padding": "12px 20px" }
  },

  "canvas": {
    "zoomSteps": [8, 12, 16, 20, 28, 36, 48, 64, 80],
    "zoomDefault": 28,
    "gridMajorEveryM": 5,
    "gridMinorEveryM": 1,
    "tickEveryM": { "gte40": 2, "gte16": 5, "else": 10 },
    "labelMinBoxPx": [70, 36],
    "edgeLabelMinPx": 44,
    "hitPx": 8,
    "vertexGrabPx": 9,
    "closeDraftPx": 10,
    "edgeInsertPx": 10,
    "handle": {
      "vertex":     { "size": 12, "bg": "surface", "border": "selection", "radius": 2 },
      "pointCenter":{ "size": 10, "bg": "selection", "border": "surface", "radius": "50%" },
      "draft":      { "size": 10, "firstSize": 14, "bg": "surface", "bgClosable": "draft", "border": "draft", "radius": "50%" },
      "calib":      { "size": 12, "bg": "calib", "border": "surface", "radius": "50%" }
    },
    "strokes": {
      "selection": { "width": 2, "pointDash": "5 3" },
      "draft":     { "width": 2, "dash": "6 4" },
      "calib":     { "width": 2, "dash": "6 4" }
    }
  },

  "export": {
    "pxPerMeter": { "min": 10, "max": 60, "targetLongSidePx": 6000 },
    "margin": 56,
    "footerHeight": 30,
    "scaleBarM": 5,
    "fontLabel": "600 13px sans-serif",
    "fontSub": "12px monospace",
    "fontFooter": "600 15px sans-serif",
    "gridMajorAlpha": 0.18
  }
}
